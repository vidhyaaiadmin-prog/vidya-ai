# ─── Supabase ───────────────────────────────────────────────
# Get from: https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# ─── Anthropic (Claude) ──────────────────────────────────────
# Get from: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-YOUR_KEY

# ─── Google Gemini ───────────────────────────────────────────
# Get from: https://aistudio.google.com/
GEMINI_API_KEY=YOUR_GEMINI_KEY

# ─── WhatsApp (Meta Cloud API) ───────────────────────────────
# Get from: https://developers.facebook.com/
WHATSAPP_PHONE_NUMBER_ID=YOUR_PHONE_NUMBER_ID
WHATSAPP_ACCESS_TOKEN=YOUR_PERMANENT_ACCESS_TOKEN
WHATSAPP_VERIFY_TOKEN=vidyaai_webhook_verify_2026

# ─── Razorpay ────────────────────────────────────────────────
# Get from: https://dashboard.razorpay.com/
RAZORPAY_KEY_ID=rzp_live_YOUR_KEY
RAZORPAY_KEY_SECRET=YOUR_SECRET
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_live_YOUR_KEY

# ─── Sentry (Error Monitoring) ───────────────────────────────
# Get from: https://sentry.io/ → Project Settings → DSN
NEXT_PUBLIC_SENTRY_DSN=

# ─── App Config ──────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Vidya AI
NODE_ENV=development

# ─── Costs (used by AI Cost Observability Dashboard) ─────────
GEMINI_FLASH_INPUT_COST_PER_M=0.10   # USD
GEMINI_FLASH_OUTPUT_COST_PER_M=0.40  # USD
CLAUDE_SONNET_INPUT_COST_PER_M=3.00  # USD
CLAUDE_SONNET_OUTPUT_COST_PER_M=15.00 # USD
USD_TO_INR=84

# ─── Feature Flags ───────────────────────────────────────────
NEXT_PUBLIC_ENABLE_OLLAMA=false
OLLAMA_BASE_URL=http://localhost:11434

# ─── Rate Limiting ───────────────────────────────────────────
# Max AI tokens per student per day — flat across all students,
# covered by the institution's license (no individual pricing tiers)
STUDENT_DAILY_TOKEN_CAP=20000
